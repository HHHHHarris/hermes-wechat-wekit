# hermes-wechat-wekit — copy to .env and fill in. NEVER commit the real .env.

# ── required ─────────────────────────────────────────────────────────────
# Bearer token you set in WeKit's "API + MCP server" settings on the phone.
# Use a long random string, not a dictionary word — it is the ONLY thing
# protecting full read/send access to the WeChat account.
WEKIT_TOKEN=replace-with-a-long-random-token

# Where the phone's WeKit API is reachable FROM THE AGENT HOST.
# Same subnet:      http://<phone-lan-ip>:3001
# Different subnet: the router DNAT address (see transport/README.md)
WEKIT_BASE_URL=http://192.168.1.50:3001

# ── strongly recommended ─────────────────────────────────────────────────
# Comma-separated wxids allowed to talk to the agent. Inbound filter only;
# it does not restrict what the agent may send.
# Find the real value in agent.log: "inbound from <wxid>".
WEKIT_ALLOWED_USERS=wxid_xxxxxxxxxxxxxx

# Instead of listing wxids by hand, put the contacts the agent may answer
# under one WeChat label (标签) and name it here. Its members are resolved at
# connect time and merged into WEKIT_ALLOWED_USERS, so the two compose — and
# you manage access from the phone rather than by editing .env.
# A label that fails to resolve is ignored, never treated as "allow everyone".
#WEKIT_ALLOWED_LABEL=hermes

# "true" disables the whitelist entirely — anyone who messages the account
# reaches your agent (and your LLM budget). Leave unset.
#WEKIT_ALLOW_ALL_USERS=false

# ── action tools: write gate ─────────────────────────────────────────────
# The agent always has the read-only and send-a-message action tools
# (wechat_pull_history, wechat_send_voice, wechat_send_video, and the list
# modes of wechat_group_members / wechat_labels).
# Set this to 1 to also allow actions that change the account or are visible
# to other people: accepting friend requests, adding/removing/inviting group
# members, assigning contact labels, and posting to Moments. Off by default —
# those tools stay registered but refuse to act.
#WEKIT_ENABLE_WRITE_ACTIONS=1

# Long-poll window in ms (default 30000). The HTTP read timeout is derived
# from this automatically.
#WEKIT_POLL_TIMEOUT_MS=30000

# wxid that scheduled/cron messages are delivered to.
#WEKIT_HOME_CHANNEL=wxid_xxxxxxxxxxxxxx

# ── receiving files/images (optional, best-effort) ───────────────────────
# Setting WEKIT_MEDIA_ADB_PATH turns on copying received media off the phone
# over adb, so the agent can actually open it. The media must already be
# downloaded on the phone (tap it, or enable WeChat's auto-download).
#WEKIT_MEDIA_ADB_PATH=/path/to/adb
#WEKIT_MEDIA_DIR=/var/lib/hermes/wechat-media

# ── ops/wechat_watchdog.py only ──────────────────────────────────────────
#WEKIT_ADB_SERIAL=          # unset = the only attached device
#WEKIT_ADB_PATH=adb
#WEKIT_LOG_PATH=wechat_watchdog.log
#WEKIT_PROBE_INTERVAL_S=120

# ── transport/router-dnat/wekit-dnat.sh only ─────────────────────────────
#WEKIT_ROUTER_WAN=          # router address the agent host connects to
#WEKIT_PHONE_HOSTNAME=      # phone's name in the DHCP lease file
#WEKIT_ALLOW_SRC=           # restrict DNAT to the agent host's IP

# ── transport/usb-bridge/wxforward.py only (fallback transport) ──────────
#WEKIT_BRIDGE_HOST=127.0.0.1
#WEKIT_BRIDGE_PORT=13001
